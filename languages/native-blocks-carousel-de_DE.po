#. Description of the plugin
#: any-block-carousel-slider.php
msgid ""
"Transform any WordPress block into a performant carousel with native CSS "
"scroll-snap. Lightweight JavaScript handles navigation, loops, and autoplay."
" Works with Gallery, Post Template, and Group blocks."
msgstr ""
"Verwandle jeden WordPress-Block mit nativem CSS Scroll Snap in ein "
"leistungsfähiges Karussell. Leichtgewichtiges JavaScript übernimmt "
"Navigation, Endlosschleifen und Autoplay. Funktioniert mit Galerie-, "
"Beitrags-Template- und Gruppenblöcken."

#: assets/js/carousel-editor.js:861
msgid "Time in milliseconds between each slide transition."
msgstr "Zeit in Millisekunden zwischen den einzelnen Slide-Übergängen."

#: assets/js/carousel-editor.js:852
msgid "Autoplay delay (ms)"
msgstr "Autoplay-Verzögerung (ms)"

#: assets/js/carousel-editor.js:844
msgid "Autoplay is disabled. Users must navigate manually."
msgstr "Autoplay ist deaktiviert. Du musst manuell navigieren."

#: assets/js/carousel-editor.js:840
msgid "The carousel will automatically scroll through slides."
msgstr "Das Karussell scrollt automatisch durch die Slides."

#: assets/js/carousel-editor.js:833
msgid "Enable autoplay"
msgstr "Autoplay aktivieren"

#: assets/js/carousel-editor.js:806
msgid "Loop is disabled. The carousel stops at the end."
msgstr "Die Endlosschleife ist deaktiviert. Das Karussell stoppt am Ende."

#: assets/js/carousel-editor.js:802
msgid ""
"The carousel will loop infinitely, returning to the first slide after the "
"last."
msgstr ""
"Das Karussell läuft in einer Endlosschleife und kehrt nach dem letzten Slide"
" zum ersten zurück."

#: assets/js/carousel-editor.js:795
msgid "Enable loop"
msgstr "Endlosschleife aktivieren"

