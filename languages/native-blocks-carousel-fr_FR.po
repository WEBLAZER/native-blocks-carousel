msgid "This plugin requires WordPress 6.0 or later."
msgstr "Cette extension nécessite WordPress 6.0 ou une version ultérieure."

msgid "WordPress version too low"
msgstr "Version de WordPress trop ancienne"

msgid "This plugin requires PHP 7.4 or later."
msgstr "Cette extension nécessite PHP 7.4 ou une version ultérieure."

msgid "PHP version too low"
msgstr "Version de PHP trop ancienne"

msgid "Chevron"
msgstr "Chevron"

msgid "Arrow"
msgstr "Flèche"

msgid "Angles"
msgstr "Angles"

