msgstr "Puces"

#: assets/js/carousel-editor.js:230 carousel-editor.js:230
msgid "Lines"
msgstr "Lignes"

#: assets/js/carousel-editor.js:237 carousel-editor.js:237
msgid "Left"
msgstr "Gauche"

#: assets/js/carousel-editor.js:241 carousel-editor.js:241
msgid "Center"
msgstr "Centre"

#: assets/js/carousel-editor.js:245 carousel-editor.js:245
