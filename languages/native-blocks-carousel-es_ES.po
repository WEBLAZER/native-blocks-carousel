msgid "This plugin requires WordPress 6.0 or later."
msgstr "Este plugin requiere WordPress 6.0 o posterior."

msgid "WordPress version too low"
msgstr "Versión de WordPress demasiado antigua"

msgid "This plugin requires PHP 7.4 or later."
msgstr "Este plugin requiere PHP 7.4 o posterior."

msgid "PHP version too low"
msgstr "Versión de PHP demasiado antigua"

msgid "Chevron"
msgstr "Chevron"

msgid "Arrow"
msgstr "Flecha"

msgid "Angles"
msgstr "Ángulos"

msgid "Dots"
msgstr "Puntos"

msgid "Lines"
msgstr "Líneas"

